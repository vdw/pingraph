<%
  input_classes = "block w-full rounded-lg border border-gray-300 dark:border-gray-600 px-3 py-2 text-sm shadow-sm bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
  label_classes = "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
%>
<div class="mt-6 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm p-6" id="two-factor">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h2 class="text-base font-semibold text-gray-900 dark:text-white">Two-factor authentication</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
        <% if user.two_factor_enabled? %>
          On since <%= local_time(user.otp_enabled_at, format: :short) %>.
          <%= pluralize(user.recovery_codes_left, "recovery code") %> left.
        <% else %>
          Off. Turn it on so a leaked password alone can't get anyone in.
        <% end %>
      </p>
    </div>
    <% unless user.two_factor_enabled? %>
      <%= link_to "Set up", new_account_two_factor_path,
            class: "rounded-lg bg-indigo-600 hover:bg-indigo-500 px-4 py-2 text-sm font-semibold text-white shadow-sm whitespace-nowrap" %>
    <% end %>
  </div>

  <% if (codes = flash[:recovery_codes]).present? %>
    <div class="mt-5 rounded-lg border border-amber-200 dark:border-amber-500/30 bg-amber-50 dark:bg-amber-900/20 p-4">
      <p class="text-sm font-semibold text-amber-800 dark:text-amber-200">Save your recovery codes now</p>
      <p class="text-sm text-amber-800 dark:text-amber-200 mt-1">
        Each one signs you in once if you lose your phone. They won't be shown again.
      </p>
      <ul class="mt-3 grid grid-cols-2 gap-x-6 gap-y-1 font-mono text-sm text-gray-900 dark:text-gray-100 select-all">
        <% codes.each do |code| %>
          <li><%= code %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if user.two_factor_enabled? %>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 border-t border-gray-200 dark:border-gray-700 pt-5">
      <%= form_with url: account_recovery_codes_path, method: :post, class: "space-y-3" do |form| %>
        <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-200">Replace recovery codes</h3>
        <%= form.label :password_challenge, "Current password", for: "recovery_password_challenge", class: label_classes %>
        <%= form.password_field :password_challenge, id: "recovery_password_challenge", required: true, autocomplete: "current-password", maxlength: 72, class: input_classes %>
        <%= form.submit "New recovery codes",
              class: "rounded-lg px-4 py-2 text-sm font-medium bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-200 cursor-pointer",
              data: { turbo_confirm: "Replace your recovery codes? The current ones will stop working." } %>
      <% end %>
      <%= form_with url: account_two_factor_path, method: :delete, class: "space-y-3" do |form| %>
        <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-200">Turn off two-factor authentication</h3>
        <%= form.label :password_challenge, "Current password", for: "disable_password_challenge", class: label_classes %>
        <%= form.password_field :password_challenge, id: "disable_password_challenge", required: true, autocomplete: "current-password", maxlength: 72, class: input_classes %>
        <%= form.submit "Turn off",
              class: "rounded-lg px-4 py-2 text-sm font-medium bg-red-50 dark:bg-red-900/20 hover:bg-red-100 dark:hover:bg-red-900/30 text-red-700 dark:text-red-400 cursor-pointer",
              data: { turbo_confirm: "Turn off two-factor authentication? Signing in will need only your password." } %>
      <% end %>
    </div>
  <% end %>
</div>
