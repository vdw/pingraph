<% content_for :title, "Account" %>

<%
  input_classes = "block w-full rounded-lg border border-gray-300 dark:border-gray-600 px-3 py-2 text-sm shadow-sm bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
  label_classes = "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
  hint_classes  = "mt-1 text-xs text-gray-400 dark:text-gray-500"
%>

<div class="max-w-xl">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Account</h1>
    <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
      Your sign-in email and password.
    </p>
  </div>

  <% if @user.must_change_password? %>
    <div class="mb-4 rounded-md border border-amber-200 dark:border-amber-500/30 bg-amber-50 dark:bg-amber-900/20 px-4 py-3 text-sm text-amber-800 dark:text-amber-200">
      <strong class="font-semibold">You're using a default or temporary password.</strong>
      Choose a new one to continue. You can also change your email address here.
    </div>
  <% end %>

  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm p-6">
    <%= form_with model: @user, url: account_path, method: :patch do |form| %>
      <% if @user.errors.any? %>
        <div class="mb-5 rounded-lg bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 px-4 py-3">
          <p class="text-sm font-semibold text-red-700 dark:text-red-400 mb-1">
            <%= pluralize(@user.errors.count, "error") %> prevented your account from being saved:
          </p>
          <ul class="list-disc ml-4 text-sm text-red-600 dark:text-red-400 space-y-0.5">
            <% @user.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-5">
        <div>
          <%= form.label :email_address, "Email", class: label_classes %>
          <%= form.email_field :email_address, required: true, autocomplete: "username", class: input_classes %>
        </div>

        <div>
          <%= form.label :password, "New password", class: label_classes %>
          <%= form.password_field :password, autocomplete: "new-password", maxlength: 72,
                required: @user.must_change_password?, class: input_classes %>
          <p class="<%= hint_classes %>">
            At least <%= User::MINIMUM_PASSWORD_LENGTH %> characters.
            <%= "Leave blank to keep your current password." unless @user.must_change_password? %>
            Changing it signs out your other browsers.
          </p>
        </div>

        <div>
          <%= form.label :password_confirmation, "Confirm new password", class: label_classes %>
          <%= form.password_field :password_confirmation, autocomplete: "new-password", maxlength: 72, class: input_classes %>
        </div>

        <div class="border-t border-gray-200 dark:border-gray-700 pt-5">
          <%= form.label :password_challenge, "Current password", class: label_classes %>
          <%= form.password_field :password_challenge, required: true, autocomplete: "current-password", maxlength: 72, class: input_classes %>
          <p class="<%= hint_classes %>">Required to save any change.</p>
        </div>
      </div>

      <div class="mt-6">
        <%= form.submit "Save account", class: "rounded-lg bg-indigo-600 hover:bg-indigo-500 px-5 py-2.5 text-sm font-semibold text-white shadow-sm cursor-pointer transition-colors" %>
      </div>
    <% end %>
  </div>

  <% unless @user.must_change_password? %>
    <%= render "two_factor", user: @user %>
  <% end %>
</div>
