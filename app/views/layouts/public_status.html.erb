<!DOCTYPE html>
<html data-controller="dark-mode">
  <head>
    <title><%= content_for(:title) || "Pingraph Status" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Pingraph Status">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-[radial-gradient(circle_at_top,rgba(56,189,248,0.14),transparent_28%),linear-gradient(180deg,#f8fafc_0%,#e2e8f0_100%)] text-slate-900 antialiased transition-colors duration-200 dark:bg-[radial-gradient(circle_at_top,rgba(56,189,248,0.12),transparent_30%),linear-gradient(180deg,#111827_0%,#0b1220_100%)] dark:text-gray-100">
    <header class="border-b border-slate-200/80 bg-white/70 backdrop-blur dark:border-white/10 dark:bg-slate-950/55">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-5 sm:px-6 lg:px-8">
        <div class="flex items-center gap-2 text-cyan-400">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12h4l2-5 4 10 2-5h6"/>
          </svg>
          <span class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">Pingraph</span>
        </div>
        <div class="flex items-center gap-3">
          <% if authenticated? %>
            <nav class="hidden sm:flex items-center gap-1 text-sm">
              <%= link_to "Dashboard", root_path,
                    class: "rounded-md px-3 py-1.5 font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-white transition-colors" %>
              <%= link_to "Groups", groups_path,
                    class: "rounded-md px-3 py-1.5 font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-white transition-colors" %>
              <%= link_to "Settings", edit_settings_path,
                    class: "rounded-md px-3 py-1.5 font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-white transition-colors" %>
            <%= button_to "Sign out", session_path, method: :delete,
              class: "rounded-md px-3 py-1.5 font-medium text-slate-500 hover:bg-slate-100 hover:text-red-600 dark:text-slate-400 dark:hover:bg-white/10 dark:hover:text-red-400 transition-colors cursor-pointer" %>
            </nav>
            <span class="hidden sm:block h-4 w-px bg-slate-300 dark:bg-white/20"></span>
          <% else %>
          <span class="hidden text-sm text-slate-500 dark:text-slate-400 sm:inline">System Status</span>
          <%= link_to "Sign in", new_session_path,
            class: "hidden sm:inline-flex rounded-md px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-white transition-colors" %>
          <% end %>
          <button data-action="dark-mode#toggle"
                  class="rounded-md p-1.5 text-slate-500 hover:bg-slate-100 dark:text-gray-400 dark:hover:bg-gray-800 transition-colors"
                  title="Toggle dark mode" aria-label="Toggle dark mode">
            <svg class="hidden dark:block w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707.707M6.343 6.343l-.707.707M12 7a5 5 0 100 10A5 5 0 0012 7z"/>
            </svg>
            <svg class="block dark:hidden w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
      <%= yield %>
    </main>

    <footer class="mx-auto max-w-6xl px-4 pb-8 text-center text-sm text-slate-500 dark:text-slate-500 sm:px-6 lg:px-8">
      <p>&copy; <%= Time.current.year %> Pingraph Project | Powered by Rails 8 &amp; Solid Queue</p>
    </footer>
  </body>
</html>
