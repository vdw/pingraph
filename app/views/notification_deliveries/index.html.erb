<% content_for :title, "Notification log" %>

<div class="w-full">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Notification log</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Every alert and what happened to it, per channel (latest 200)</p>
    </div>
    <%= link_to "Notification settings", edit_settings_path,
          class: "rounded-md px-3 py-2 text-sm bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 font-medium text-gray-700 dark:text-gray-200" %>
  </div>

  <% if @deliveries.any? %>
    <div class="overflow-x-auto rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-sm">
      <table class="min-w-full divide-y divide-gray-100 dark:divide-gray-700">
        <thead class="bg-gray-50 dark:bg-gray-700/50">
          <tr>
            <th class="py-3 px-4 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Time</th>
            <th class="py-3 px-4 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Host</th>
            <th class="py-3 px-4 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Event</th>
            <th class="py-3 px-4 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Channel</th>
            <th class="py-3 px-4 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Result</th>
            <th class="py-3 px-4"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50 dark:divide-gray-700">
          <% @deliveries.each do |delivery| %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 align-top">
              <td class="py-3 px-4 text-sm text-gray-500 dark:text-gray-400 font-mono whitespace-nowrap">
                <%= local_time(delivery.created_at, format: :datetime) %>
              </td>
              <td class="py-3 px-4 text-sm font-medium text-gray-900 dark:text-white">
                <% if delivery.host %>
                  <%= link_to delivery.host_name, host_path(delivery.host), class: "hover:text-indigo-600 dark:hover:text-indigo-400" %>
                <% else %>
                  <%= delivery.host_name %> <span class="text-xs text-gray-400">(deleted)</span>
                <% end %>
              </td>
              <td class="py-3 px-4 text-sm text-gray-700 dark:text-gray-200">
                <%= delivery.notification_payload.headline.capitalize %>
              </td>
              <td class="py-3 px-4 text-sm text-gray-500 dark:text-gray-400"><%= delivery.channel.capitalize %></td>
              <td class="py-3 px-4 text-sm">
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium
                  <%= case delivery.status
                      when "sent" then "bg-green-50 dark:bg-green-900/20 text-green-700 dark:text-green-400"
                      when "failed" then "bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-400"
                      else "bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300"
                      end %>">
                  <%= delivery.pending? && delivery.attempts.positive? ? "Retrying" : delivery.status.humanize %>
                </span>
                <span class="ml-1 text-xs text-gray-400 dark:text-gray-500"><%= pluralize(delivery.attempts, "attempt") %></span>
                <% if delivery.error_message.present? && !delivery.sent? %>
                  <p class="mt-1 text-xs text-red-600 dark:text-red-400 max-w-md break-words"><%= delivery.error_message %></p>
                <% end %>
              </td>
              <td class="py-3 px-4 text-right">
                <% if delivery.failed? %>
                  <%= button_to "Retry", retry_notification_delivery_path(delivery),
                        class: "rounded-md px-3 py-1 text-xs bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 font-medium text-gray-700 dark:text-gray-200 cursor-pointer" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-xl border border-dashed border-gray-300 dark:border-gray-700 p-10 text-center text-sm text-gray-500 dark:text-gray-400">
      No alerts sent yet. They appear here when a host changes state and a notification channel is enabled.
    </div>
  <% end %>
</div>
