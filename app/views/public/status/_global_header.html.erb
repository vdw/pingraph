<%
  title, accent_classes = case overall_state
  when :down
    ["Major Outage", "bg-red-50 border-red-200 text-red-800 dark:bg-red-500/15 dark:border-red-500/30 dark:text-red-100"]
  when :degraded
    ["Partial Degradation", "bg-amber-50 border-amber-200 text-amber-800 dark:bg-amber-500/15 dark:border-amber-500/30 dark:text-amber-100"]
  when :operational
    ["All Systems Operational", "bg-emerald-50 border-emerald-200 text-emerald-800 dark:bg-emerald-500/15 dark:border-emerald-500/30 dark:text-emerald-100"]
  else
    ["Status Unavailable", "bg-slate-100 border-slate-200 text-slate-700 dark:bg-slate-500/15 dark:border-slate-500/30 dark:text-slate-100"]
  end
%>

<section class="mb-8 rounded-2xl border <%= accent_classes %> px-6 py-5 shadow-2xl shadow-slate-200/70 backdrop-blur-sm dark:shadow-black/20">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-sm uppercase tracking-[0.2em] text-slate-500 dark:text-slate-300"><%= group.present? ? group.name : "Public Status" %></p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight text-slate-900 dark:text-white"><%= title %></h1>
      <% if group&.description.present? %>
        <p class="mt-2 max-w-2xl text-sm text-slate-600 dark:text-slate-300"><%= group.description %></p>
      <% end %>
    </div>
    <div class="text-sm text-slate-600 dark:text-slate-300">
      <p>Last updated: <%= generated_at.strftime("%B %-d, %Y, %-I:%M %p") %></p>
    </div>
  </div>
</section>
