<%
  host = host_row[:host]
  latest_result = host_row[:latest_result]
  status = host_row[:state]
  badge_class = case status
    when :down then "bg-red-500/15 text-red-700 dark:text-red-200"
    when :degraded then "bg-amber-500/15 text-amber-700 dark:text-amber-100"
    when :operational then "bg-emerald-500/15 text-emerald-700 dark:text-emerald-100"
    else "bg-slate-600/20 text-slate-700 dark:bg-slate-600/30 dark:text-slate-200"
  end
  summary = if latest_result.nil?
    "No probe data"
  elsif latest_result.http?
    latest_result.success? ? "HTTP #{latest_result.status_code}" : (latest_result.error_message.presence || "HTTP failure")
  elsif latest_result.tcp?
    latest_result.success? ? "TCP connectivity OK" : (latest_result.error_message.presence || "Connection failure")
  else
    latest_result.packet_loss.present? ? "Packet Loss: #{latest_result.packet_loss}%" : "ICMP status unavailable"
  end
%>

<div class="grid gap-4 px-5 py-4 lg:grid-cols-[280px_minmax(0,1fr)_220px] lg:items-center">
  <div>
    <div class="flex items-center gap-2">
      <h4 class="text-lg font-medium text-slate-900 dark:text-white"><%= host.public_label %></h4>
      <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold uppercase <%= badge_class %>">
        <%= status.to_s.humanize %>
      </span>
    </div>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= summary %></p>
  </div>

  <div>
    <div class="mb-1 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
      <span>24h uptime</span>
      <span class="font-medium text-slate-700 dark:text-slate-200">
        <%= host_row[:uptime_percentage] ? "#{host_row[:uptime_percentage]}%" : "N/A" %>
      </span>
    </div>
    <%= render "uptime_bar", blocks: host_row[:blocks], large: false %>
  </div>

  <div class="text-sm text-slate-600 dark:text-slate-300 lg:text-right">
    <p><span class="text-slate-500 dark:text-slate-500">Avg Latency:</span> <%= host_row[:average_latency] ? "#{format('%.2f', host_row[:average_latency])}ms" : "N/A" %></p>
    <% if latest_result&.recorded_at %>
      <p class="mt-1 text-slate-500 dark:text-slate-500">Last check: <%= latest_result.recorded_at.strftime("%-I:%M %p") %></p>
    <% end %>
  </div>
</div>
